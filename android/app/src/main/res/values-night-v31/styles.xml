<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">#15141C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo_white</item>
        <item name="android:postSplashScreenTheme">@style/AppThemePostSplash</item>
        <item name="android:statusBarColor">#15141C</item>
        <item name="android:navigationBarColor">#15141C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppThemePostSplash" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ECE9D9</item>
        <item name="android:statusBarColor">#15141C</item>
        <item name="android:navigationBarColor">#15141C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
